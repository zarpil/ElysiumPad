# ==============================================================================
#                 ELYSIUMPAD — VARIABLES DE ENTORNO PARA PRODUCCIÓN
# ==============================================================================
# Configura estas variables en tu entorno de Coolify o en un archivo .env:

# --- Configuración del Servidor y Base de Datos ---
NODE_ENV=production
POSTGRES_USER=postgres
POSTGRES_PASSWORD=genera_una_contrasena_segura_aqui_123
POSTGRES_DB=elysiumpad
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@elysiumpad-db:5432/elysiumpad?schema=public

# URL pública con la que tus usuarios y launchers accederán (con HTTPS en producción)
NEXT_PUBLIC_APP_URL=https://launcher.tudominio.com

# Secreto JWT para sesiones seguras (genera uno con: openssl rand -hex 32)
JWT_SECRET=super-secreto-jwt-de-al-menos-32-caracteres-aleatorios

# --- Administrador Principal Inicial (Seed) ---
# Al desplegar por primera vez, el sistema creará automáticamente este administrador:
INITIAL_ADMIN_EMAIL=admin@elysiumpad.com
INITIAL_ADMIN_PASSWORD=CambiaEstaContrasena123!

# --- Cloudflare R2 (Almacenamiento CDN de Mods, Logos y Banners) ---
# Opcional: si se deja vacío, los archivos se guardan localmente en /public/uploads
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=minecraft-launchers
R2_PUBLIC_DOMAIN=https://pub-r2.tudominio.com

# --- Cloudflare Tunnel (Opcional - HTTPS sin abrir puertos) ---
CLOUDFLARE_TUNNEL_TOKEN=

# --- Pasarela de Pagos (Stripe) — [Se activará al final] ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
